// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("OPERATOR") // ADMIN, OPERATOR
  active      Boolean  @default(true)
  preferences String? // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotations Quotation[]
}

model Client {
  id           String   @id @default(uuid())
  name         String
  cnpj         String?  @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  smartcomexId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotations Quotation[]
}

model Quotation {
  id         String    @id @default(uuid())
  reference  String?   @unique
  status     String    @default("SOLICITADO") // SOLICITADO, AGUARDANDO_AGENTE, RETORNO_RECEBIDO, APPROVED, SENT, EXPIRED
  validUntil DateTime?

  // Agente / Coloader
  agentEmail              String?
  agentName               String?
  draftEmail              String? // Rascunho do email para o agente
  draftEmailSubject       String? // Assunto gerado/traduzido do e-mail ao agente
  clientReferenceNumber   String? // Referência/PO do próprio cliente (extraído por IA ou manual)
  agentEmailCode          String? // Código gerado 1x: iniciais do operador + data + hora (ex: GDS-050826-1555)
  sentAt                  DateTime? // Horário do envio pelo Outlook
  sentEmailConversationId String? // conversationId do MS Graph para tracking de thread
  agentResponseRaw        String? // Corpo do e-mail de retorno do agente (para auditoria)

  // Type Info
  direction String // IMPORT, EXPORT
  modal     String // SEA, AIR
  loadType  String // LCL, FCL_20, FCL_40, FCL_40HC, AIR_GENERAL, AIR_CONSOLIDATED

  // Relations
  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id])
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])

  supplierName    String?
  supplierCountry String?
  supplierCity    String?

  // Route
  incoterm           String?
  originPort         String?
  originCity         String?
  originCountry      String?
  destinationPort    String?
  destinationCity    String?
  destinationCountry String?
  transitTimeDays    Int?
  connections        String?

  // Cargo
  cargoDescription   String?
  ncmCodes           String? // Stored as comma separated string
  contractNumber     String?
  commercialValue    Float?
  commercialCurrency String? @default("USD")
  totalGrossWeightKg Float?
  totalNetWeightKg   Float?
  totalCbm           Float?
  totalPackages      Int?
  isImo              Boolean @default(false)
  isPerishable       Boolean @default(false)
  requiresAnvisa     Boolean @default(false)
  requiresArmy       Boolean @default(false)
  requiresMapa       Boolean @default(false)

  packages String? // Stored as JSON string

  // Costs
  freightValue               Float?
  freightCurrency            String?
  iofUsd                     Float?
  carrier                    String?
  carrierProfileId           String?
  carrierProfile             CarrierProfile? @relation(fields: [carrierProfileId], references: [id])
  vesselName                 String?
  voyageNumber               String?
  freeTimeDays               Int?
  rateValidUntil             DateTime?
  rateValiditySource         String? // AGENT_EMAIL, TARIFF, CONTINGENCY, MANUAL
  rateValidityEvidence       String? // trecho de e-mail/tarifário que comprovou a vigência
  rateValidityConfidence     Float?
  rateValidityNeedsReview    Boolean         @default(false)
  transshipments             String? // JSON array estruturado
  destinationStorage         Float?
  destinationStorageCurrency String?
  destinationServicesTotal   Float?
  destinationServices        String? // JSON string
  destinationTaxes           Float?
  destinationTaxesCurrency   String?
  originServices             String? // JSON string
  originServicesTotal        Float?
  needsOriginInland          Boolean         @default(false)
  originInlandRoute          String?
  originInlandValue          Float?
  originInlandCurrency       String?         @default("USD")
  originInlandTransitTime    String?

  totalBrl    Float?
  totalUsd    Float?
  frequency   String?
  weightBreak String?

  // Gestão de Profit
  costsData       String? // JSON string
  salesData       String? // JSON string
  expectedProfit  Float?  @default(0)
  insuranceProfit Float?  @default(0)

  notes String? // JSON string array

  sourceEmails             String? // JSON string array
  sourceEmailRecords       String? // JSON com metadados, corpo original e contato identificado em cada e-mail
  extractionAudit          String? // JSON com fonte e confiança de cada informação extraída
  sourceDocuments          String? // JSON string array
  aiConfidence             Float?
  smartcomexSynced         Boolean @default(false)
  customsClearanceIncluded Boolean @default(false)
  requiresInsurance        Boolean @default(false)

  // Transporte Terrestre Nacional
  needsTransport     Boolean   @default(false)
  truckerName        String?
  truckerEmail       String?
  transportRoute     String?
  truckerDraftEmail  String?
  truckerSentAt      DateTime?
  truckerResponseRaw String?
  truckerValue       Float?
  truckerCurrency    String?   @default("BRL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentResponses  AgentResponseVersion[]
  documents       QuotationDocument[]
  emailDispatches QuotationEmailDispatch[]

  @@index([carrierProfileId])
}

model DocumentBlob {
  id        String   @id @default(uuid())
  sha256    String   @unique
  mimeType  String
  size      Int
  content   Bytes
  createdAt DateTime @default(now())

  documents QuotationDocument[]
}

model QuotationDocument {
  id                  String       @id @default(uuid())
  quotationId         String
  quotation           Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  blobId              String
  blob                DocumentBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)
  originalName        String
  origin              String       @default("MANUAL") // CLIENT_EMAIL, MANUAL, WHATSAPP, PARTNER_REPLY
  sourceContainerName String?
  forwardByDefault    Boolean      @default(true)
  createdById         String?
  createdAt           DateTime     @default(now())

  @@unique([quotationId, blobId, originalName, origin])
  @@index([quotationId, createdAt])
}

model QuotationEmailDispatch {
  id              String    @id @default(uuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  recipientType   String    @default("PARTNER")
  recipientEmail  String
  subject         String?
  conversationId  String?
  attachmentIds   String? // JSON array dos documentos efetivamente enviados
  attachmentNames String? // JSON array para auditoria imutável
  status          String    @default("SENT")
  errorMessage    String?
  createdAt       DateTime  @default(now())

  @@index([quotationId, createdAt])
}

model AgentResponseVersion {
  id               String    @id @default(uuid())
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  messageId        String    @unique
  conversationId   String?
  subject          String?
  senderEmail      String?
  receivedAt       DateTime?
  matchLayer       Int?
  latestText       String?
  quotedHistory    String?
  signature        String?
  attachmentNames  String? // JSON array
  extractedData    String? // JSON com valores e evidências retornados pela IA
  confidence       Float?
  processingStatus String    @default("PROCESSING") // PROCESSING, SUCCESS, NO_VALUES, FAILED
  errorMessage     String?
  attempts         Int       @default(0)
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([quotationId, receivedAt])
  @@index([processingStatus])
}

model KnowledgeEntry {
  id          String  @id @default(uuid())
  category    String // rule, template, tariff, procedure, faq, scenario
  title       String
  content     String
  appliesTo   String? // JSON string
  priority    Int     @default(0)
  active      Boolean @default(true)
  createdById String
  tags        String? // Comma separated string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id           String  @id @default(uuid())
  name         String
  email        String?
  type         String  @default("AGENTE") // AGENTE, COLOADER, ARMADOR
  networks     String? // Ex: "WCA, JCtrans"
  address      String?
  phone        String?
  website      String?
  contacts     Json? // Array de contatos ex: [{"name":"John","email":"j@a.com"}]
  modals       String? // Ex: "Aéreo, Marítimo FCL"
  origins      String? // Ex: "China, Estados Unidos, APAC"
  destinations String? // Ex: "Brasil"
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FixedFee {
  id               String          @id @default(uuid())
  name             String
  carrier          String?
  containerSize    String?
  type             String // ORIGIN, DESTINATION
  value            Float
  currency         String // USD, BRL
  modal            String // SEA_FCL, SEA_LCL, AIR, ROAD
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  carrierProfileId String?
  carrierProfile   CarrierProfile? @relation(fields: [carrierProfileId], references: [id])

  @@index([carrierProfileId])
}

model CarrierProfile {
  id              String   @id @default(uuid())
  name            String   @unique
  code            String?
  aliases         String? // JSON array
  modal           String   @default("SEA")
  equipmentScopes String?  @default("[\"20GP\",\"40GP\",\"40HC\"]") // JSON array de equipamentos habilitados
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotations Quotation[]
  fieldRules CarrierFieldRule[]
  fixedFees  FixedFee[]
  rates      CarrierRate[]
}

model ChargeCatalog {
  id               String   @id @default(uuid())
  standardizedName String   @unique
  acronym          String?
  description      String?
  aliases          String? // JSON array com nomes e códigos observados
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rates         CarrierRate[]
  applicability ChargeApplicability[]
}

model ChargeApplicability {
  id               String        @id @default(uuid())
  chargeCatalogId  String
  chargeCatalog    ChargeCatalog @relation(fields: [chargeCatalogId], references: [id], onDelete: Cascade)
  incoterm         String
  modal            String        @default("SEA_FCL")
  operationalStage String?
  applicability    String // YES, NO, CONDITIONAL
  classification   String?
  usualApplication String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([chargeCatalogId, incoterm, modal])
  @@index([incoterm, modal, applicability])
}

model CarrierRateImportBatch {
  id           String    @id @default(uuid())
  fileName     String
  status       String    @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  totalRows    Int       @default(0)
  importedRows Int       @default(0)
  skippedRows  Int       @default(0)
  warningRows  Int       @default(0)
  warnings     String? // JSON array
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  rates CarrierRate[]
}

model CarrierRate {
  id                  String                  @id @default(uuid())
  carrierProfileId    String
  carrierProfile      CarrierProfile          @relation(fields: [carrierProfileId], references: [id], onDelete: Restrict)
  chargeCatalogId     String
  chargeCatalog       ChargeCatalog           @relation(fields: [chargeCatalogId], references: [id], onDelete: Restrict)
  importBatchId       String?
  importBatch         CarrierRateImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  originalCode        String?
  originalDescription String?
  portScope           String?
  equipment           String?
  currency            String
  amount              Float
  unitBasis           String
  application         String?
  modal               String                  @default("SEA_FCL")
  type                String                  @default("DESTINATION")
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  status              String                  @default("REFERENCE") // REFERENCE, APPROVED, EXPIRED, REJECTED
  conditional         Boolean                 @default(false)
  active              Boolean                 @default(true)
  sourceFingerprint   String                  @unique
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  evidences CarrierRateEvidence[]

  @@index([carrierProfileId, status, active])
  @@index([portScope, equipment, modal, type])
  @@index([effectiveFrom, effectiveTo])
}

model CarrierRateEvidence {
  id            String      @id @default(uuid())
  carrierRateId String
  carrierRate   CarrierRate @relation(fields: [carrierRateId], references: [id], onDelete: Cascade)
  sourceRef     String
  sourceType    String      @default("INVOICE") // INVOICE, OFFICIAL_TARIFF, OTHER
  notes         String?
  observedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([carrierRateId])
}

model CarrierFieldRule {
  id        String         @id @default(uuid())
  carrierId String
  carrier   CarrierProfile @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  modal     String         @default("ALL")
  stage     String         @default("RETURN")
  fieldKey  String
  behavior  String
  reason    String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([carrierId, modal, stage, fieldKey])
  @@index([carrierId, modal, stage])
}

model StandardFee {
  id            String   @id @default(uuid())
  name          String
  type          String // ORIGIN, DESTINATION
  chargeType    String // FIXED, PER_KG, PER_DOCUMENT, PERCENTAGE
  value         Float
  pricingStatus String   @default("PRICED") // PRICED, ON_REQUEST
  minValue      Float?
  currency      String
  percentBase   String? // FREIGHT, FREIGHT_PLUS_ORIGIN
  description   String?
  modalScope    String   @default("ALL") // ALL ou lista CSV: AIR,SEA_FCL,SEA_LCL
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  incotermRules IncotermRule[]
}

model IncotermRule {
  id               String   @id @default(uuid())
  incoterm         String // EXW, FCA, FOB, CIF, CFR, DAP, DDP
  modal            String // AIR, SEA_FCL, SEA_LCL, ALL
  direction        String   @default("ALL") // IMPORT, EXPORT, ALL
  originScope      String? // Porto/cidade/país de origem; nulo = qualquer origem
  destinationScope String? // Porto/cidade/país de destino; nulo = qualquer destino
  required         Boolean  @default(false)
  feeType          String // ORIGIN, DESTINATION
  feeName          String // Ex: "Airport Fee", "AWB Fee", "Origin Charges"
  chargeType       String // FIXED, PER_KG, PER_DOCUMENT, PERCENTAGE
  value            Float // Valor unitário ou percentual
  pricingStatus    String   @default("PRICED") // snapshot da taxa: PRICED, ON_REQUEST
  minValue         Float? // Valor mínimo (ex: Airport Fee mín USD 45)
  currency         String   @default("USD")
  percentBase      String? // Se PERCENTAGE: "FREIGHT", "FREIGHT_PLUS_ORIGIN"
  description      String? // Descrição informativa para o operador
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Fonte oficial da taxa. Os campos acima permanecem temporariamente para
  // compatibilidade e migração dos registros criados antes deste vínculo.
  standardFeeId String?
  standardFee   StandardFee? @relation(fields: [standardFeeId], references: [id], onDelete: Restrict)

  @@index([standardFeeId])
  @@index([incoterm, modal, direction])
}

model IncotermFieldRule {
  id        String   @id @default(uuid())
  incoterm  String
  modal     String
  direction String   @default("ALL")
  stage     String   @default("ALL")
  fieldKey  String
  behavior  String
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([incoterm, modal, direction, stage, fieldKey])
  @@index([incoterm, modal, direction, stage])
}

model AgentDraftEmailSettings {
  id              String   @id @default(uuid())
  subjectTemplate String   @default("{quotationCode} | {direction} {modal} - {incoterm} | {origin} x {destination} | {client} | {clientReference}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AgentDraftEmailTemplate {
  id              String   @id @default(uuid())
  name            String
  incoterm        String   @default("ALL")
  modal           String   @default("ALL") // AIR, SEA_FCL, SEA_LCL, ALL
  direction       String   @default("ALL") // IMPORT, EXPORT, ALL
  equipment       String   @default("ALL") // 20GP, 40GP, 40HC, 20RH, 40RH, 20OT, 40OT, ALL
  subjectTemplate String?
  bodyTemplate    String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([incoterm, modal, direction, equipment, active])
}

model DraftEmailFieldRule {
  id         String   @id @default(uuid())
  modal      String   @default("ALL") // SEA, AIR, ALL
  direction  String   @default("ALL") // IMPORT, EXPORT, ALL
  fieldLabel String
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([modal, direction])
}

model PricingSettings {
  id               String   @id @default(uuid())
  ptaxMode         String   @default("D1_CLOSE") // D1_CLOSE (fechamento anterior) | D0_OPEN (abertura do dia)
  minLclStorageBrl Float    @default(5700)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Deconsolidator {
  id        String   @id @default(uuid())
  name      String // "Ohpers", "Richard", "Cadu"
  location  String? // "GRU", "VCP", nome do porto, etc
  modal     String // SEA_FCL, SEA_LCL, AIR
  value     Float
  currency  String   @default("BRL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modal])
}
